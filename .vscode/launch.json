{
    "version": "0.2.0",
    "configurations": [
        
        {
            "name": "convert_to_lerobot_sim.py",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/tools/convert_to_lerobot_sim.py",
            "console": "integratedTerminal",
            "args": [
                "--src_path",
                "${workspaceFolder}/dataset/Manipulation-SimData/stamp_the_seal",
                "--tgt_path",
                "${workspaceFolder}/test/stamp_the_seal",
                "--task_id",
                "train"
            ],
            "justMyCode": false
        },
        {
            "name": "Debug finetune_genie.py with torchrun",
            "type": "debugpy",
            "request": "launch",
            "module": "torch.distributed.run",
            "args": [
                "--nproc_per_node=1",
                "scripts/finetune.py"
            ],
            "console": "integratedTerminal",
            "justMyCode": false
        }
    ]
}